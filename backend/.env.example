# Backend
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
USE_DEMO_DATA=true
DEFAULT_KELLY_FRACTION=0.25
CACHE_TTL_SECONDS=120

# The Odds API — https://the-odds-api.com
ODDS_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Scheduler (APScheduler)
SCHEDULER_ENABLED=true
SYNC_INTERVAL_MINUTES=30
SYNC_ON_STARTUP=false
# Optional: require this header value as X-Admin-Token for /api/v1/admin/*
ADMIN_API_TOKEN=

# CORS
# CORS_ORIGINS=["http://localhost:3000"]

# --- AI / RAG chat + bet-memory embeddings ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
BET_MEMORY_EMBED_INTERVAL_MINUTES=15
BET_MEMORY_BATCH_SIZE=50

# --- Understat xG/xGA ---
# Season start year, e.g. 2025 for the 2025/26 season.
UNDERSTAT_SEASON=2025
