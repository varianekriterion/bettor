# Backend
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# Set false + ODDS_API_KEY for real fixtures/odds (see README)
USE_DEMO_DATA=false
DEFAULT_KELLY_FRACTION=0.25
CACHE_TTL_SECONDS=300
SCRAPE_TIMEOUT_SECONDS=5
# Set true to hit Forebet/PredictZ/etc. (often blocked with HTTP 403 from datacenters)
USE_LIVE_SCRAPERS=true
MATCH_BUILD_CONCURRENCY=8

# The Odds API — https://the-odds-api.com
ODDS_API_KEY=

# Football-Data.org — https://www.football-data.org
FOOTBALL_DATA_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Scheduler (APScheduler)
SCHEDULER_ENABLED=true
SYNC_INTERVAL_MINUTES=30
SYNC_ON_STARTUP=false
# Optional: require this header value as X-Admin-Token for /api/v1/admin/*
ADMIN_API_TOKEN=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- AI / RAG chat + bet-memory embeddings ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
BET_MEMORY_EMBED_INTERVAL_MINUTES=15
BET_MEMORY_BATCH_SIZE=50

# --- Prediction settlement (Step 3) ---
SETTLEMENT_ENABLED=true
SETTLEMENT_CRON_HOUR=3
SETTLEMENT_CRON_MINUTE=0
SETTLEMENT_LOOKBACK_DAYS=14
SETTLEMENT_ROLLUP_DAYS=30

# --- Understat xG/xGA ---
# Season start year, e.g. 2025 for the 2025/26 season.
UNDERSTAT_SEASON=2025

# --- API-Football per-90 stats (Step 4) ---
# https://www.api-football.com — free tier: 100 requests/day
API_FOOTBALL_KEY=
API_FOOTBALL_SEASON=2025
STATS_CACHE_TTL_DAYS=7
API_FOOTBALL_DAILY_LIMIT=95
